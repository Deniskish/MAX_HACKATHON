{
  "name": "opora-api",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start:prod": "node dist/server.js",
    "test": "tsx --test privacy.test.ts gigachat.test.ts company-data/*.test.ts funding-catalog/*.test.ts ai/*.test.ts app.test.ts contracts.test.ts",
    "sync:sources": "tsx ai/sync-sources.ts",
    "sync:fns": "tsx company-data/sync.ts"
  },
  "dependencies": {
    "compression": "1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "iconv-lite": "^0.7.3",
    "linkedom": "^0.18.13",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "yaml": "^2.9.1"
  },
  "version": "0.1.0",
  "private": true
}
